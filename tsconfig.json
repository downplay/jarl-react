{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "jarl-react": ["./packages/jarl-react/source/index.ts"]
        },
        "types": ["node", "vitest/globals"]
    },
    "include": [
        "packages/jarl-react/source/**/*.ts",
        "packages/jarl-react/source/**/*.tsx",
        "packages/jarl-react/tools/**/*.ts",
        "scripts/**/*.ts",
        "demo/**/*.ts",
        "demo/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules",
        "**/es/**",
        "**/lib/**",
        "**/umd/**"
    ]
}
