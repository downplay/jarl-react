{
    "name": "jarl-react-redux",
    "version": "1.0.0-beta.5",
    "description": "Redux integration for JARL",
    "keywords": [
        "components",
        "history",
        "hoc",
        "react",
        "reactjs",
        "redux",
        "router",
        "routing",
        "ssr",
        "tools",
        "url"
    ],
    "license": "MIT",
    "author": "Peter Hurst",
    "repository": {
        "type": "git",
        "url": "https://github.com/downplay/jarl-react.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "ci-test": "vitest run",
        "build": "rolldown -c",
        "watch": "rolldown -c -w",
        "clean": "git clean -fdX .",
        "lint": "oxlint source --max-warnings 0"
    },
    "dependencies": {
        "invariant": "^2.2.4",
        "jarl-react": "^1.0.0-beta.5",
        "prop-types": "^15.8.1"
    },
    "devDependencies": {
        "@cfaester/enzyme-adapter-react-18": "^0.8.0",
        "@vitejs/plugin-react": "^6.0.5",
        "enzyme": "^3.11.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "peerDependencies": {
        "react": ">=18.0.0"
    }
}
