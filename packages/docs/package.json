{
    "name": "jarl-react-docs",
    "version": "0.1.0",
    "private": true,
    "description": "Docs & demo site for JARL (Just Another Router Library for React). Self-contained Vite SSR/SSG build, dogfooding the v2 jotai-atoms router for its own navigation.",
    "type": "module",
    "scripts": {
        "docs:dev": "node scripts/dev-server.mjs",
        "docs:build": "node scripts/build.mjs",
        "docs:preview": "vite preview --outDir dist --port 4173",
        "dev": "npm run docs:dev",
        "build": "npm run docs:build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "jotai": "^2.9.3",
        "marked": "^12.0.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "typescript": "^5.5.4",
        "vite": "^5.4.6"
    }
}
