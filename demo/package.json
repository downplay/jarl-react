{
    "name": "jarl-react-demo-sites",
    "version": "1.0.0-beta.5",
    "private": true,
    "scripts": {
        "cypress": "cypress open",
        "dev": "vite --port 3210",
        "start": "node ./server/production.js",
        "start-prod": "node ./server/production.js",
        "build": "vite build",
        "clean": "git clean -fdX .",
        "lint": "oxlint . --max-warnings 0",
        "ci-stop": "pkill -SIGINT JARLDEMO",
        "ci-cypress": "cypress run --record --key ${CYPRESS_DASHBOARD} --env JARL_VERSION=${JARL_VERSION},CIRCLE_BUILD_NUM=${CIRCLE_BUILD_NUM}",
        "ci-start": "node ./server/production.js",
        "local-e2e-run": "npm-run-all ci-cypress ci-stop",
        "local-e2e": "npm-run-all --parallel ci-start local-e2e-run"
    },
    "dependencies": {
        "express": "^4.19.2",
        "history": "^4.10.1",
        "jarl-react": "^1.0.0-beta.5",
        "prismjs": "^1.30.0",
        "prop-types": "^15.8.1",
        "ramda": "^0.25.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-emotion": "^8.0.12",
        "react-helmet": "^5.2.0",
        "react-pdf-js": "^3.0.7",
        "react-remarkable": "^1.1.3",
        "recompose": "^0.26.0",
        "semantic-ui-css": "^2.3.1",
        "semantic-ui-react": "^0.79.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.0.5",
        "cypress": "^2.1.0",
        "documentation": "^6.1.0",
        "emotion": "^8.0.12",
        "emotion-theming": "^8.0.12",
        "npm-run-all": "^4.1.2",
        "react-docgen": "^2.20.1",
        "vite": "^8.2.1"
    }
}
