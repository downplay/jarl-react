{
    "name": "jarl-react-packages",
    "private": true,
    "workspaces": [
        "packages/jarl-react",
        "packages/jarl-react-redux",
        "demo"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present",
        "start": "npm run dev --workspace demo",
        "dev": "npm run dev --workspace demo",
        "test": "npm run test --workspaces --if-present",
        "ci-test": "npm run ci-test --workspaces --if-present",
        "ci-publish": "npm publish --workspaces",
        "notify": "node ./scripts/notify.js",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt .",
        "format:check": "oxfmt . --check"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.0.5",
        "discord.js": "^11.3.2",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "rolldown": "^1.2.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "cheerio": "1.0.0-rc.12"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
