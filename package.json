{
    "name": "jarl-react-packages",
    "private": true,
    "workspaces": [
        "packages/jarl-react",
        "demo"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present",
        "start": "npm run dev --workspace demo",
        "dev": "npm run dev --workspace demo",
        "test": "npm run test --workspaces --if-present",
        "ci-test": "npm run ci-test --workspaces --if-present",
        "ci-publish": "npm publish --workspaces",
        "notify": "node ./scripts/notify.ts",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt .",
        "format:check": "oxfmt . --check",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@babel/plugin-syntax-jsx": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.1",
        "@types/enzyme": "^3.10.0",
        "@types/express": "^4.17.0",
        "@types/history": "^4.7.11",
        "@types/hoist-non-react-statics": "^3.3.0",
        "@types/invariant": "^2.2.37",
        "@types/jsesc": "^3.0.3",
        "@types/node": "^20.0.0",
        "@types/prismjs": "^1.26.6",
        "@types/prop-types": "^15.7.0",
        "@types/qs": "^6.9.0",
        "@types/ramda": "^0.32.0",
        "@types/react": "^16.14.0",
        "@types/react-dom": "^16.9.0",
        "@types/react-test-renderer": "^16.9.12",
        "@types/recompose": "^0.30.15",
        "@types/warning": "^3.0.4",
        "@vitejs/plugin-react": "^6.0.5",
        "discord.js": "^11.3.2",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "rolldown": "^1.2.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "cheerio": "1.0.0-rc.12"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
